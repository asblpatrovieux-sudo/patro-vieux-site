{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "patro-vieux-site",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
"vars": {
  "ALLOWED_ORIGIN": "https://patro-vieux-site.asblpatrovieux.workers.dev",
  "NEON_STORAGE_BUCKET": "documents",
  "AWS_REGION": "eu-central-1",
  "AWS_ENDPOINT_URL_S3": "https://br-floral-bar-b9etq0c7.storage.c-7.eu-central-1.aws.neon.tech",
  "NEON_DATA_API_URL": "https://ep-small-mode-b9dz0wb5.apirest.c-7.eu-central-1.aws.neon.tech/neondb/rest/v1"
},
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
